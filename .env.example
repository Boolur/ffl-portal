DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
NEXTAUTH_SECRET=replace-with-strong-secret
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@ffl.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin User
DEFAULT_USER_PASSWORD=ChangeMe123!
MS_TENANT_ID=your-tenant-id
MS_CLIENT_ID=your-client-id
MS_CLIENT_SECRET=your-client-secret

# Functional Microsoft 365 sender mailboxes
MS_SENDER_NOREPLY_EMAIL=noreply@bisuhomeloans.com
MS_SENDER_LEADS_EMAIL=leads@bisuhomeloans.com
MS_SENDER_DISCLOSURES_EMAIL=disclosures@bisuhomeloans.com
MS_SENDER_ORIGINATIONS_EMAIL=originations@bisuhomeloans.com
MS_SENDER_PROCESSING_EMAIL=processing@bisuhomeloans.com
MS_REQUIRE_CATEGORY_SENDERS=false

# Temporary rollback fallback; remove after the migration window.
MS_SENDER_EMAIL=

# Optional separate scoped Mail.Read app for the Sent Items audit script.
MS_AUDIT_TENANT_ID=
MS_AUDIT_CLIENT_ID=
MS_AUDIT_CLIENT_SECRET=
EMAIL_BRAND_LOGO_URL=

# Supabase Storage (private buckets recommended)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET_TASK_ATTACHMENTS=task-attachments
SUPABASE_STORAGE_BUCKET_CLIENT_DOCUMENTS=client-documents
SUPABASE_SIGNED_URL_TTL_SECONDS=600